# Copy this file to .winbar.env and edit only the local copy.
# The local file is ignored by Git and copied into SwiftBar during installation.

WINBAR_SSH_ALIAS=windows-monitor
WINBAR_REFRESH_SECONDS=30
WINBAR_SSH_TIMEOUT=15
WINBAR_RETENTION_DAYS=30

# Optional paths. Uncomment only when overriding the defaults.
# WINBAR_CACHE_PATH=~/.cache/winbar-monitor/cache.json
# WINBAR_HISTORY_PATH=~/.local/share/winbar-monitor/history.sqlite3
# WINBAR_REPORT_PATH=~/.local/share/winbar-monitor/history.html
# SWIFTBAR_PLUGIN_DIR="$HOME/Library/Application Support/SwiftBar/Plugins"
