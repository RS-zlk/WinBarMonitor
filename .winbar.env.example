# Copy this file to .winbar.env and edit only the local copy.
# The local file is ignored by Git and copied into SwiftBar during installation.

WINBAR_SSH_ALIAS=windows-monitor
WINBAR_REFRESH_SECONDS=30
WINBAR_SSH_TIMEOUT=15
WINBAR_RETENTION_DAYS=30

# Recommended: Windows writes metrics locally every 30 seconds; macOS only
# reads the prepared files over SSH.  Install windows/install-windows-collector.ps1
# on Windows before enabling this mode.
WINBAR_DATA_SOURCE=windows-files
WINBAR_REMOTE_DATA_DIR='C:\ProgramData\WinBarMonitor'
WINBAR_WINDOWS_SAMPLE_SECONDS=30

# Legacy alternative: run each metric query through SSH from macOS.  This does
# not collect while the Mac is off.
# WINBAR_DATA_SOURCE=direct-ssh

# Optional task-complete alert. It is disabled by default; configure it from
# the SwiftBar menu, or set these values here (percentages and seconds).
# WINBAR_LOW_USAGE_ALERT_ENABLED=true
# WINBAR_LOW_USAGE_GPU_THRESHOLD=5
# WINBAR_LOW_USAGE_VRAM_THRESHOLD=10
# WINBAR_LOW_USAGE_DURATION_SECONDS=300

# Optional paths. Uncomment only when overriding the defaults.
# WINBAR_CACHE_PATH=~/.cache/winbar-monitor/cache.json
# WINBAR_HISTORY_PATH=~/.local/share/winbar-monitor/history.sqlite3
# WINBAR_REPORT_PATH=~/.local/share/winbar-monitor/history.html
# WINBAR_ALERT_STATE_PATH=~/.local/share/winbar-monitor/low-usage-alert-state.json
# SWIFTBAR_PLUGIN_DIR="$HOME/Library/Application Support/SwiftBar/Plugins"
